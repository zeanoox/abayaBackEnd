# --- Server ---
PORT=4000
NODE_ENV=development
# Public URL of this API (Mollie sends webhooks here; must be reachable from the internet in production)
API_PUBLIC_URL=http://localhost:4000
# Public URL of the storefront (customers are sent back here after paying)
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lorim
# Set to true for hosted databases that require SSL (Render, Supabase, Railway)
DATABASE_SSL=false

# --- Payments ---
# "mollie" in production. "mock" is a local-only fake provider for testing the flow; it is refused when NODE_ENV=production.
PAYMENT_PROVIDER=mollie
# Use a test_ key until you go live. Never commit the real key.
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Unpaid orders release their reserved stock after this many minutes
ORDER_RESERVATION_MINUTES=60
